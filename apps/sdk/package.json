{
  "name": "@streamkit/sdk",
  "version": "0.1.0",
  "main": "./dist/streamkit.umd.js",
  "module": "./dist/streamkit.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/streamkit.esm.js",
      "require": "./dist/streamkit.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.0",
    "rollup": "^4.28.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
